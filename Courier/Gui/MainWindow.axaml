<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Courier.Gui.MainWindow"
        Title="Courier Dispatch"
        Width="1040"
        Height="680"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0B1220" Offset="0" />
            <GradientStop Color="#101D35" Offset="0.55" />
            <GradientStop Color="#07111F" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Styles>
        <Style Selector="TextBlock.kicker">
            <Setter Property="Foreground" Value="#7F95B3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.8" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#8EA0B8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#5B8CFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#3A1D2A" />
            <Setter Property="Foreground" Value="#FF8FA3" />
            <Setter Property="BorderBrush" Value="#7A2C42" />
        </Style>
        <Style Selector="Button.success">
            <Setter Property="Background" Value="#123D32" />
            <Setter Property="Foreground" Value="#7EF0C3" />
            <Setter Property="BorderBrush" Value="#24755E" />
        </Style>
    </Window.Styles>

    <Grid Margin="30" RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24">
            <Border Width="54"
                    Height="54"
                    CornerRadius="16"
                    Background="#172A48"
                    BorderBrush="#315481"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="CD"
                           Foreground="#9FC0FF"
                           FontSize="17"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           LetterSpacing="1" />
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="COURIER DISPATCH" Classes="kicker" Foreground="#6F9BFF" />
                <TextBlock Text="Панель курьера"
                           Foreground="#F4F8FF"
                           FontSize="29"
                           FontWeight="Bold" />
            </StackPanel>

            <Border Grid.Column="2"
                    Background="#101F36"
                    CornerRadius="18"
                    Padding="16,10"
                    BorderBrush="#203A5B"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Ellipse Width="9" Height="9" Fill="#34D399" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="Ожидание запуска"
                               Foreground="#C8D5E6"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="1.18*,0.82*" ColumnSpacing="22">
            <Border Background="#0F1B2F"
                    CornerRadius="24"
                    Padding="28"
                    BorderBrush="#1E3552"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="ТЕКУЩИЙ ЗАКАЗ" Classes="kicker" />
                        <Border Grid.Column="1"
                                Background="#13263F"
                                CornerRadius="10"
                                Padding="10,5">
                            <TextBlock x:Name="OrderIdText"
                                       Text="НЕТ АКТИВНОГО"
                                       Foreground="#7F95B3"
                                       FontSize="11"
                                       FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Height="3"
                            Margin="0,18,0,22"
                            Background="#28456A"
                            CornerRadius="2" />

                    <StackPanel Grid.Row="2" Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Адрес доставки" Classes="muted" />
                            <TextBlock x:Name="AddressText"
                                       Text="Ожидание заказа"
                                       Foreground="#F4F8FF"
                                       FontSize="27"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Что доставить" Classes="muted" />
                            <TextBlock x:Name="DescriptionText"
                                       Text="Здесь появится описание заказа."
                                       Foreground="#B8C9DD"
                                       FontSize="16"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="3" VerticalAlignment="Bottom" Margin="0,28,0,0">
                        <Border Background="#0A1526"
                                CornerRadius="14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Ellipse Width="9" Height="9" Fill="#5B8CFF" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Курьер назначается автоматически после появления заказа"
                                           Classes="muted"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="LIVE"
                                           Foreground="#34D399"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="12"
                                Margin="0,22,0,0">
                        <Button x:Name="CancelButton"
                                Classes="danger"
                                Content="Отменить"
                                IsEnabled="False"
                                Click="OnCancelClick" />
                        <Button x:Name="DoneButton"
                                Classes="success"
                                Content="Доставил"
                                IsEnabled="False"
                                Click="OnDoneClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#0E1A2C"
                    CornerRadius="24"
                    Padding="20"
                    BorderBrush="#1E3552"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="МАРШРУТ" Classes="kicker" />
                            <TextBlock x:Name="MapAddressText"
                                       Text="Схема появится после заказа"
                                       Foreground="#B8C9DD"
                                       FontSize="13" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="#123D32"
                                CornerRadius="10"
                                Padding="9,5"
                                VerticalAlignment="Center">
                            <TextBlock Text="В СЕТИ"
                                       Foreground="#7EF0C3"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,18,0,16"
                            Background="#0A1425"
                            CornerRadius="18"
                            ClipToBounds="True">
                        <Viewbox Stretch="Uniform" Margin="12">
                            <Canvas Width="390" Height="340">
                                <Path Data="M 32,286 C 105,205 122,258 183,191 C 243,124 283,135 350,48"
                                      Stroke="#284668"
                                      StrokeThickness="5"
                                      StrokeDashArray="7,5"
                                      StrokeLineCap="Round" />
                                <Ellipse Canvas.Left="21" Canvas.Top="275" Width="22" Height="22" Fill="#5B8CFF" />
                                <Ellipse Canvas.Left="339" Canvas.Top="37" Width="22" Height="22" Fill="#34D399" />
                                <Ellipse Canvas.Left="173" Canvas.Top="181" Width="20" Height="20" Fill="#F2C94C" />
                                <Ellipse Canvas.Left="172" Canvas.Top="180" Width="22" Height="22" Fill="Transparent" Stroke="#F2C94C" StrokeThickness="1" />
                                <TextBlock Canvas.Left="24" Canvas.Top="306"
                                           Text="СТАРТ"
                                           Foreground="#627C9D"
                                           FontSize="11"
                                           FontWeight="Bold" />
                                <TextBlock Canvas.Left="312" Canvas.Top="68"
                                           Text="ЗАКАЗ"
                                           Foreground="#627C9D"
                                           FontSize="11"
                                           FontWeight="Bold" />
                                <TextBlock Canvas.Left="28" Canvas.Top="40"
                                           Text="СХЕМА МАРШРУТА"
                                           Foreground="#334E70"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           LetterSpacing="2" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="Схема является иллюстрацией маршрута."
                               Classes="muted"
                               FontSize="11" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,22,0,0">
            <TextBlock Text="Заказы приходят автоматически после выхода на линию."
                       Classes="muted"
                       VerticalAlignment="Center" />
            <Button x:Name="StartButton"
                    Grid.Column="1"
                    Classes="primary"
                    Content="Выйти на линию"
                    Click="OnStartClick" />
        </Grid>
    </Grid>
</Window>
